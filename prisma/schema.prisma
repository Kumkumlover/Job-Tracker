generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  emailVerified       DateTime?
  image               String?
  apiKey              String?              @unique @default(cuid())
  apolloKey           String?
  geminiKey           String?
  hunterKey           String?
  serperKey           String?
  accounts            Account[]
  applications        Application[]
  cachedEmails        CachedEmail[]
  customProperties    CustomProperty[]
  customStages        CustomStage[]
  DomainApiLimit      DomainApiLimit[]
  emailGuessHistories EmailGuessHistory[]
  feedbackEntries     FeedbackEntry[]
  gmailSyncState      GmailSyncState?
  linkedGmailAccounts LinkedGmailAccount[]
  outreachCampaigns   OutreachCampaign[]
  patternRecords      PatternRecord[]
  profileContext      ProfileContext?
  sessions            Session[]
  vaultItems          VaultItem[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Application {
  id             String        @id @default(cuid())
  userId         String
  company        String
  role           String
  platform       String        @default("manual")
  status         String        @default("applied")
  dateApplied    DateTime      @default(now())
  followUpDate   DateTime?
  jobUrl         String?
  salaryMin      Int?
  salaryMax      String?
  salaryCurrency String?       @default("INR")
  location       String?
  locationType   String?
  notes          String?
  linkedinDmSent Boolean       @default(false)
  emailThreadId  String?
  jobDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customValues   CustomValue[]
  touchpoints    Touchpoint[]

  @@unique([userId, company, role])
  @@index([userId, status])
  @@index([userId, dateApplied])
  @@index([userId, followUpDate])
}

model Touchpoint {
  id             String      @id @default(cuid())
  applicationId  String
  type           String
  source         String
  date           DateTime    @default(now())
  notes          String?
  emailMessageId String?
  metadata       Json?
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model CustomProperty {
  id        String        @id @default(cuid())
  userId    String
  name      String
  slug      String
  type      String        @default("text")
  options   Json?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  values    CustomValue[]

  @@unique([userId, slug])
}

model CustomValue {
  id               String         @id @default(cuid())
  applicationId    String
  customPropertyId String
  value            String
  application      Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  customProperty   CustomProperty @relation(fields: [customPropertyId], references: [id], onDelete: Cascade)

  @@unique([applicationId, customPropertyId])
}

model CustomStage {
  id        String   @id @default(cuid())
  userId    String
  name      String
  slug      String
  color     String   @default("#6b7280")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
}

model GmailSyncState {
  id            String    @id @default(cuid())
  userId        String    @unique
  lastSyncedAt  DateTime?
  lastHistoryId String?
  backfillDone  Boolean   @default(false)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LinkedGmailAccount {
  id           String    @id @default(cuid())
  userId       String
  email        String
  accessToken  String
  refreshToken String?
  expiresAt    Int?
  lastSyncedAt DateTime?
  backfillDone Boolean   @default(false)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
}

model ProfileContext {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  resume                 String?
  skills                 String?
  background             String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  aboutMeBullets         String?
  emailTemplateStructure String?
  linkedinUrl            String?
  phone                  String?
  portfolioUrl           String?
  senderName             String?  @default("Shikhar Gupta")
  systemPrompt           String?
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailGuessHistory {
  id        String   @id @default(cuid())
  userId    String
  company   String
  domain    String
  pattern   String
  isSuccess Boolean  @default(false)
  bounced   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([company])
  @@index([domain])
}

model OutreachCampaign {
  id            String    @id @default(cuid())
  userId        String
  company       String
  role          String
  hiringManager String?
  emails        Json
  subject       String
  body          String
  status        String    @default("draft")
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VaultItem {
  id        String   @id @default(cuid())
  userId    String
  type      String
  vaultType String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, vaultType])
}

model PatternRecord {
  id           String   @id @default(cuid())
  userId       String
  pattern      String
  domain       String?
  successCount Int      @default(0)
  usageCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern, domain])
}

model CachedEmail {
  id         String   @id @default(cuid())
  userId     String
  email      String
  name       String
  domain     String
  pattern    String
  confidence Float
  source     String
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, domain])
}

model FeedbackEntry {
  id        String   @id @default(cuid())
  userId    String
  email     String
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DomainApiLimit {
  id        String   @id
  userId    String
  domain    String
  count     Int      @default(0)
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
}
